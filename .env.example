# ==========================================
# AgentShield Arena Configuration
# ==========================================

# LLM Provider Configuration
# Set to 'deterministic' (default) to run completely offline without paid API keys.
# Set to 'openai' to use a live OpenAI model (requires OPENAI_API_KEY).
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
MODEL_NAME=gpt-4o

# Security & Policy Configuration
STRICT_POLICY_ENFORCEMENT=true
REQUIRE_HUMAN_APPROVAL_FOR_HIGH_RISK=true

# Output Configuration
AUDIT_LOG_PATH=outputs/audit_trail.jsonl
INCIDENT_REPORT_PATH=outputs/incident_report.md

# ==========================================
# Notification & Automation Integrations
# ==========================================

# Brevo (Sendinblue) Email API — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=agentshield@yourdomain.com
BREVO_SENDER_NAME=AgentShield Arena
# Comma-separated list of admin emails for security alert notifications
ADMIN_EMAILS=admin@yourdomain.com

# Telegram Bot Integration — https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated Telegram chat IDs (send /start to bot to get your chat ID)
TELEGRAM_CHAT_IDS=

# Google Gemini AI — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
